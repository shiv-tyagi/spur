[Unit]
Description=Spur CI Runner (slot %i)
After=network-online.target
Wants=network-online.target

[Service]
User={{ ci_user }}
Group={{ ci_user }}
WorkingDirectory={{ runner_install_dir }}/%i
EnvironmentFile=/etc/spur-ci/slots/%i.env
ExecStart={{ runner_install_dir }}/%i/run.sh
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
